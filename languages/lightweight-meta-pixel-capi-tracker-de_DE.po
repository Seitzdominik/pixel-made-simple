msgid "Global Options"
msgstr "Globale Optionen"

#: C:/Users/Seitz/Documents/Claude/lightweight_meta_pixel_and_capi_tracker/dev-tools/../lightweight-meta-pixel-capi-tracker/includes/class-lmpct-admin.php:711
#: C:/Users/Seitz/Documents/Claude/lightweight_meta_pixel_and_capi_tracker/dev-tools/../lightweight-meta-pixel-capi-tracker/includes/class-lmpct-admin.php:714
msgid "Do not track administrators"
msgstr "Administratoren nicht tracken"

#: C:/Users/Seitz/Documents/Claude/lightweight_meta_pixel_and_capi_tracker/dev-tools/../lightweight-meta-pixel-capi-tracker/includes/class-lmpct-admin.php:718
msgid "Recommended: logged-in administrators trigger neither pixel nor server events."
msgstr "Empfohlen: Eingeloggte Administratoren lösen weder Pixel- noch Server-Events aus."

#: C:/Users/Seitz/Documents/Claude/lightweight_meta_pixel_and_capi_tracker/dev-tools/../lightweight-meta-pixel-capi-tracker/includes/class-lmpct-admin.php:723
msgid "Automatic cookie banner detection (GDPR)"
msgstr "Automatische Cookie-Banner-Erkennung (DSGVO)"

#: C:/Users/Seitz/Documents/Claude/lightweight_meta_pixel_and_capi_tracker/dev-tools/../lightweight-meta-pixel-capi-tracker/includes/class-lmpct-admin.php:726
msgid "Enable automatic cookie banner detection"
msgstr "Automatische Cookie-Banner-Erkennung aktivieren"

#: C:/Users/Seitz/Documents/Claude/lightweight_meta_pixel_and_capi_tracker/dev-tools/../lightweight-meta-pixel-capi-tracker/includes/class-lmpct-admin.php:730
msgid "Automatically detects installed cookie banners and blocks browser and CAPI events until consent is given. Supports Must Have Plugins Cookie Bar, Borlabs Cookie, Complianz, Real Cookie Banner, CookieYes, Cookiebot, SureCookies and any banner using the WP Consent API. Automatic blocking cannot be guaranteed for unlisted third-party banners. Sites without a cookie banner are never blocked."
