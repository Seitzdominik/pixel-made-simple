#: includes/class-lmpct-admin.php:607
msgid "Event Name (internal)"
msgstr "Event-Name (intern)"

#: includes/class-lmpct-admin.php:611
msgid "e.g. Lead magnet confirmation"
msgstr "z. B. Lead Magnet Bestätigung"

#: includes/class-lmpct-admin.php:613
